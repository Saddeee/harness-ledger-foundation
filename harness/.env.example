# Local Harness service config. Copy to .env (untracked) and fill in as needed.
# All optional for Checkpoint A -- SQLite path is the only thing the server reads today.

# Where the local SQLite database file lives. Relative paths resolve from harness/.
HARNESS_DB_PATH=./data/harness.db

# Reserved for later checkpoints (correction mining / analysis roles). Never commit real values.
# OPENAI_API_KEY=

# Where the Lovable OAuth credentials live (mode 0600, gitignored).
# Defaults to lovable-auth.json next to HARNESS_DB_PATH. Never commit this file.
# HARNESS_AUTH_PATH=./data/lovable-auth.json
